# Default is real Tencent MCP. Demo is explicit historical data only.
ROUTEPILOT_MAP_MODE=tencent
ROUTEPILOT_DATABASE=data/trips.sqlite3
TENCENT_MAP_KEY=
# Separate browser-visible keys; never copy TENCENT_MAP_KEY here.
TENCENT_JS_KEY=
TENCENT_NAV_KEY=
ROUTEPILOT_MAP_INTERVAL=5
ROUTEPILOT_OPERATION_TIMEOUT=180
